{
  "manifest_version": 2,
  "name": "SNCF Voucher Reminder",
  "version": "1.0",
  "description": "Manage SNCF Connect vouchers and get reminders when you have valid vouchers to use",
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.svg",
    "default_title": "SNCF Voucher Reminder"
  },
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.sncf-connect.com/*", "*://sncf-connect.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },
  "applications": {
    "gecko": {
      "id": "wagonbar@scabon.com",
      "strict_min_version": "57.0"
    }
  }
}
