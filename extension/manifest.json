{
  "manifest_version": 3,
  "name": "SNCF Voucher Reminder",
  "version": "1.3",
  "description": "Manage SNCF Connect vouchers and get reminders when you have valid vouchers to use",
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.svg",
    "default_title": "SNCF Voucher Reminder"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wagonbar@scabon.com",
      "strict_min_version": "141.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "android": {
        "strict_max_version": "79.0"
      }
    }
  }
}
